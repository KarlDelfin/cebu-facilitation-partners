import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { GoogleGenAI } from "https://esm.sh/@google/genai"

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods': 'POST, OPTIONS'
}

const RAW_GITHUB_FILES = [
  "https://raw.githubusercontent.com/karldelfin/cebu-facilitation-partners/main/src/views/HomeView.vue", 
];

async function getRepositoryKnowledge() {
  let combinedKnowledge = "";
  
  for (const url of RAW_GITHUB_FILES) {
    try {
      const res = await fetch(url, { headers: { "Cache-Control": "no-cache" } });
      if (res.ok) {
        const textContent = await res.text();
        combinedKnowledge += `\n--- Source File Content (${url}) ---\n${textContent}\n`;
      }
    } catch (err) {
      console.error("Failed fetching repo file:", err.message);
    }
  }
  return combinedKnowledge;
}

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const apiKey = Deno.env.get("GEMINI_API_KEY")
    if (!apiKey) {
      return new Response(JSON.stringify({ reply: "Configuration Error: GEMINI_API_KEY missing." }), {
        headers: { ...corsHeaders, "Content-Type": "application/json" }
      })
    }

    const { message } = await req.json()

    const siteKnowledgeBase = await getRepositoryKnowledge();

    const ai = new GoogleGenAI({ apiKey })
    const aiResponse = await ai.models.generateContent({
      model: "gemini-3.5-flash", 
      contents: `You are a direct, professional customer support chatbot for Upskills Facilitation Partners.
      Answer the user's question concisely and straight to the point using the website data below.

      CRITICAL FORMATTING RULES:
      1. DO NOT use Markdown formatting like asterisks (**) or dashes (- ) for lists.
      2. USE BASIC HTML TAGS instead for structure:
        - Use <strong>text</strong> for bold words.
        - Use <ul><li>Item</li></ul> for bulleted lists.
        - Use <br /> for line breaks.
      3. BE DIRECT: Skip conversational filler, conversational openings, and greetings. Answer the question immediately using the HTML format.

      WEBSITE SOURCE KNOWLEDGE BASE:
      ${siteKnowledgeBase || "Upskills Facilitation Partners offers high-quality team building, corporate planning, and event facilitation services."}

      CLIENT QUESTION: 
      ${message}`
    })

    return new Response(JSON.stringify({ reply: aiResponse.text }), {
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })

  } catch (globalError) {
    return new Response(JSON.stringify({ reply: `Snag encountered: ${globalError.message}` }), {
      headers: { ...corsHeaders, "Content-Type": "application/json" }
    })
  }
})